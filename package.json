{
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "STRIPE_SECRET_KEY=x STRIPE_WEBHOOK_SECRET=x auth generate --config src/lib/auth.ts --output /tmp/ba.prisma -y",
    "build": "prisma generate && next build",
    "db:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "db:migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "db:seed": "dotenv -e .env.development -- prisma db seed",
    "dbpush:dev": "dotenv -e .env.development -- prisma db push",
    "dbpush:prod": "dotenv -e .env.production -- prisma db push",
    "dev": "next dev --turbopack",
    "email:dev": "email dev",
    "format": "ultracite fix",
    "postinstall": "prisma generate",
    "lint": "ultracite check",
    "start": "next start",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/auth/stripe/webhook",
    "typecheck": "prisma generate && tsc --noEmit",
    "upgrade:deps": "tsx scripts/upgrade-deps.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
