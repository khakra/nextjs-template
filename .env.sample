NEXT_PUBLIC_PROJECT_NAME="SkyNet"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_META_DESCRIPTION="AI will take over, starting with this app"

DATABASE_URL="postgresql://user:pwd@localhost:5432/nextjs-template?schema=public"
# Connections per server instance. Keep low on serverless and point
# DATABASE_URL at a pooler (PgBouncer / Neon -pooler / Supabase :6543).
DATABASE_POOL_MAX="10"

# Generate a unique secret per environment — never reuse this placeholder:
#   pnpm exec auth secret   (or: openssl rand -hex 32)
BETTER_AUTH_SECRET="replace-generate-your-own-secret"
BETTER_AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID="1234"
GOOGLE_CLIENT_SECRET="5678"

EMAIL_FROM=""
AWS_SES_ACCESS_KEY=""
AWS_SES_SECRET_KEY=""
AWS_SES_REGION="us-west-2"

# File storage (src/lib/storage.ts) — AWS S3 or any S3-compatible store.
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. "us-east-1").
# Cloudflare R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_REGION="auto".
# MinIO / local: set S3_ENDPOINT and S3_FORCE_PATH_STYLE="true".
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_FORCE_PATH_STYLE="false"
# Optional public base URL for getPublicUrl() (R2 custom domain / r2.dev URL, CloudFront, ...)
S3_PUBLIC_URL=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Subscription plan price IDs (use test-mode prices in .env.development)
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_EXPERT=""
