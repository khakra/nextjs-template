{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!node_modules",
      "!.claude",
      "!.next",
      "!dist",
      "!build",
      // Third-party static assets — not ours to format or add titles to.
      "!public",
      "!src/components/ui",
      "!src/app/dashboard/theme.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "complexity": {
        "useMaxParams": "off"
      },
      "performance": {
        // Flags every inline arrow in a JSX prop. Turning it on means threading
        // useCallback through ~30 call sites for a benefit React's own docs
        // consider situational. Enable deliberately if you want that trade.
        "noJsxPropsBind": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        // Alphabetises every object literal's keys. Config objects read better
        // grouped by meaning than by spelling, so this stays off; imports are
        // still sorted above.
        "useSortedKeys": "off"
      }
    }
  }
}
